    },
    {
      "key": "entry.General.RandomizeOnLevelStart.name",
      "value": "Dar arma al entrar en un nivel"
    },
    {
      "key": "entry.General.RandomizeOnLevelStart.description",
      "value": "Da armas aleatorias al entrar en un nivel que no sea zona segura."
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.name",
      "value": "Arma aleatoria por baja"
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.description",
      "value": "Si está activado, cada baja de un enemigo válido te da un arma generada al azar."
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.name",
      "value": "Enfriamiento de la recompensa por baja"
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.description",
      "value": "Tiempo de espera, en segundos, entre recompensas de arma por baja."
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.name",
      "value": "Recompensa solo en niveles jugables"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.description",
      "value": "Si está activado, las recompensas por baja solo se dan en niveles jugables que no sean zona segura."
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.name",
      "value": "Recompensa solo con experiencia"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.description",
      "value": "Si está activado, solo las unidades que dan más de 0 de experiencia al morir activan la recompensa. Así se evitan casi todos los objetos del escenario y lo que no sea un enemigo."
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.name",
      "value": "Registrar comprobaciones de recompensa"
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.description",
      "value": "Escribe en el registro los detalles de cada comprobación de recompensa por baja. Déjalo desactivado para jugar con normalidad."
    },
    {
      "key": "entry.General.AnnouncePickup.name",
      "value": "Avisar al recibir un arma"
    },
    {
      "key": "entry.General.AnnouncePickup.description",
      "value": "Muestra un aviso de recogida cuando se genera un arma aleatoria."
    },
    {
      "key": "entry.General.PreferredWeaponSlot.name",
      "value": "Ranura de arma preferida"
