    {
      "key": "entry.General.PreferredWeaponSlot.description",
      "value": "En qué ranura de arma se coloca el arma generada."
    },
    {
      "key": "entry.General.GeneratedWeaponCount.name",
      "value": "Cantidad de armas generadas"
    },
    {
      "key": "entry.General.GeneratedWeaponCount.description",
      "value": "Cuántas armas generadas llevas a la vez. Con 2, al entrar en un nivel se llenan las dos ranuras de arma y cada baja reemplaza el arma generada más antigua. Las armas que tengas equipadas pasan a la mochila."
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.name",
      "value": "Cambiar al arma generada"
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.description",
      "value": "Cambia automáticamente al arma generada después de equiparla."
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.name",
      "value": "Eliminar armas generadas antiguas"
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.description",
      "value": "Antes de generar un arma nueva, elimina las que este mod generó anteriormente."
    },
    {
