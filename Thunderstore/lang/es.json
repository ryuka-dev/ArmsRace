      "value": "Eliminar armas generadas al cambiar de nivel"
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.description",
      "value": "Elimina las armas generadas antes de cambiar de nivel y al morir, para que nunca lleguen a tu partida guardada."
    },
    {
      "key": "entry.Safety.DestroyGeneratedWeaponsOnDrop.name",
