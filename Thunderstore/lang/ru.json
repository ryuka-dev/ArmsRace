    {
      "key": "entry.General.RandomizeOnLevelStart.name",
      "value": "Оружие при входе на уровень"
    },
    {
      "key": "entry.General.RandomizeOnLevelStart.description",
      "value": "Выдаёт случайное оружие при входе на уровень вне безопасной зоны."
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.name",
      "value": "Случайное оружие за убийство"
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.description",
      "value": "Если включено, за убийство подходящего врага вы получаете случайно созданное оружие."
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.name",
      "value": "Интервал награды за убийство"
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.description",
      "value": "Время в секундах между наградами оружием за убийства."
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.name",
      "value": "Награда только на игровых уровнях"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.description",
      "value": "Если включено, награды за убийства выдаются только на игровых уровнях вне безопасной зоны."
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.name",
      "value": "Награда только за цели с опытом"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.description",
      "value": "Если включено, награду дают только цели, за убийство которых начисляется опыт (больше 0). Это отсекает большинство предметов окружения и прочие объекты, не являющиеся врагами."
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.name",
      "value": "Журнал проверок награды"
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.description",
      "value": "Подробно записывает в журнал проверки наград за убийства. Для обычной игры оставьте выключенным."
    },
    {
      "key": "entry.General.AnnouncePickup.name",
      "value": "Уведомление о получении"
    },
    {
      "key": "entry.General.AnnouncePickup.description",
      "value": "Показывает уведомление о получении, когда создаётся случайное оружие."
    },
    {
      "key": "entry.General.PreferredWeaponSlot.name",
      "value": "Предпочитаемый слот оружия"
    },
    {
      "key": "entry.General.PreferredWeaponSlot.description",
      "value": "В какой слот оружия помещать созданное оружие."
    },
    {
      "key": "entry.General.GeneratedWeaponCount.name",
      "value": "Количество созданного оружия"
    },
    {
      "key": "entry.General.GeneratedWeaponCount.description",
      "value": "Сколько созданного оружия вы носите одновременно. При значении 2 при входе на уровень заполняются оба слота оружия, а каждое убийство заменяет более старое созданное оружие. Экипированное оружие перемещается в рюкзак."
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.name",
      "value": "Переключаться на созданное оружие"
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.description",
      "value": "Автоматически берёт созданное оружие в руки после экипировки."
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.name",
      "value": "Удалять старое созданное оружие"
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.description",
      "value": "Перед созданием нового оружия удаляет оружие, созданное этим модом ранее."
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.name",
      "value": "Удалять созданное оружие при смене уровня"
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.description",
      "value": "Удаляет созданное оружие перед сменой уровня и при смерти, чтобы оно никогда не попало в сохранение."
    },
    {
      "key": "entry.Safety.DestroyGeneratedWeaponsOnDrop.name",
