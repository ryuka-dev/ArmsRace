    {
      "key": "entry.General.EnableMod.name",
      "value": "MODを有効化"
    },
    {
      "key": "entry.General.EnableMod.description",
      "value": "このMODを有効にします。"
    },
    {
      "key": "entry.General.RandomizeOnLevelStart.name",
      "value": "レベル開始時に武器を配布"
    },
    {
      "key": "entry.General.RandomizeOnLevelStart.description",
      "value": "セーフゾーン以外のレベルに入ったときに、ランダムな武器を配布します。"
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.name",
      "value": "キルでランダム武器を配布"
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.description",
      "value": "オンにすると、対象の敵をキルしたときにランダムな生成武器を1つ入手します。"
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.name",
      "value": "キル報酬のクールダウン"
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.description",
      "value": "キル報酬でランダム武器を入手できる間隔（秒）です。"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.name",
      "value": "プレイ可能なレベルでのみ報酬"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.description",
      "value": "オンにすると、セーフゾーン以外のプレイ可能なレベルでのみキル報酬が発生します。"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.name",
      "value": "経験値を得られる相手のみ報酬"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.description",
      "value": "オンにすると、倒して経験値を得られる相手だけがランダム武器の報酬対象になります。置物など、敵以外のものの大半を除外できます。"
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.name",
      "value": "キル報酬の判定をログに記録"
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.description",
      "value": "キル報酬の判定内容を詳しくログに記録します。通常プレイではオフのままにしてください。"
    },
    {
      "key": "entry.General.AnnouncePickup.name",
      "value": "入手通知"
    },
    {
      "key": "entry.General.AnnouncePickup.description",
      "value": "ランダムな武器が生成されたときに入手通知を表示します。"
    },
    {
      "key": "entry.General.PreferredWeaponSlot.name",
      "value": "優先する武器スロット"
    },
    {
      "key": "entry.General.PreferredWeaponSlot.description",
      "value": "生成武器をどの武器スロットに入れるかを選びます。"
    },
    {
      "key": "entry.General.GeneratedWeaponCount.name",
      "value": "生成武器の所持数"
    },
    {
      "key": "entry.General.GeneratedWeaponCount.description",
      "value": "同時に持てる生成武器の数。2 にすると、レベルに入ったときに両方の武器スロットが埋まり、キルごとに古いほうの生成武器が入れ替わります。装備中の武器はバックパックに移動します。"
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.name",
      "value": "生成武器に自動で持ち替え"
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.description",
      "value": "生成武器を装備したあと、自動でその武器に持ち替えます。"
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.name",
      "value": "古い生成武器を削除"
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.description",
      "value": "新しい武器を生成する前に、このMODが以前に生成した武器を削除します。"
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.name",
      "value": "レベル移動前に生成武器を削除"
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.description",
      "value": "レベルの移動や死亡の処理が行われる前に生成武器を削除し、セーブデータに残らないようにします。"
    },
