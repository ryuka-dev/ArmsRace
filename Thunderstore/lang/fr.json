      "value": "Armes en début de niveau"
    },
    {
      "key": "entry.General.RandomizeOnLevelStart.description",
      "value": "Donne des armes aléatoires à l'entrée d'un niveau hors zone sûre."
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.name",
      "value": "Arme aléatoire par élimination"
    },
    {
      "key": "entry.Kill Reward.EnableRandomWeaponOnKill.description",
      "value": "Si activé, éliminer un ennemi éligible donne une arme générée aléatoirement."
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.name",
      "value": "Délai de récompense d'élimination"
    },
    {
      "key": "entry.Kill Reward.RandomWeaponOnKillCooldown.description",
      "value": "Délai en secondes entre deux récompenses d'élimination."
    },
    {
