      "value": "Récompense en niveau jouable uniquement"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequiresPlayableLevel.description",
      "value": "Si activé, les récompenses d'élimination ne se déclenchent que dans les niveaux jouables hors zone sûre."
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.name",
      "value": "Récompense seulement si la cible donne de l'XP"
    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.description",
      "value": "Si activé, seules les cibles qui rapportent de l'XP une fois éliminées peuvent déclencher une récompense. Cela exclut la plupart des décors et des objets qui ne sont pas des ennemis."
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.name",
      "value": "Journaliser les récompenses d'élimination"
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.description",
      "value": "Enregistre le détail des vérifications de récompense d'élimination. À laisser désactivé en jeu normal."
    },
    {
      "key": "entry.General.AnnouncePickup.name",
      "value": "Annoncer le ramassage"
    },
    {
      "key": "entry.General.AnnouncePickup.description",
      "value": "Affiche une notification de ramassage lorsqu'une arme aléatoire est générée."
    },
    {
      "key": "entry.General.PreferredWeaponSlot.name",
      "value": "Emplacement d'arme préféré"
    },
    {
      "key": "entry.General.PreferredWeaponSlot.description",
      "value": "Emplacement d'arme qui reçoit l'arme générée."
    },
    {
      "key": "entry.General.GeneratedWeaponCount.name",
      "value": "Nombre d'armes générées"
    },
    {
      "key": "entry.General.GeneratedWeaponCount.description",
      "value": "Nombre d'armes générées que vous portez en même temps. À 2, entrer dans un niveau remplit les deux emplacements d'arme et chaque élimination remplace l'arme générée la plus ancienne. Les armes que vous avez équipées vont dans votre sac à dos."
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.name",
      "value": "Passer à l'arme générée"
    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.description",
      "value": "Passe automatiquement à l'arme générée une fois celle-ci équipée."
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.name",
      "value": "Supprimer les anciennes armes générées"
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.description",
      "value": "Supprime les armes générées précédemment par ce mod avant d'en créer une nouvelle."
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.name",
      "value": "Supprimer avant le changement de niveau"
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.description",
      "value": "Supprime les armes générées avant les changements de niveau et à la mort, afin qu'elles n'atteignent jamais votre sauvegarde."
    },
    {
      "key": "entry.Safety.DestroyGeneratedWeaponsOnDrop.name",
